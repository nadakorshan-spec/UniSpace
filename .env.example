# Server
PORT=4000
NODE_ENV=development
# Comma-separated trusted browser origins. Required in production.
# Development also allows localhost/127.0.0.1 on ports 5173 and 5174.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL (required) - use the same credentials for the test DB by changing the database name
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/unispase?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/unispase_test?schema=public"

# JWT (required) - replace with long random strings in any shared environment
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# OpenAI (optional for local start; required for live AI study plan generation)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
