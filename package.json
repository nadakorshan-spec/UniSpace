{
  "name": "unispace",
  "version": "1.0.0",
  "private": true,
  "description": "UniSpace - AI-powered Student Life Management SaaS",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @unispace/server",
    "dev:web": "npm run dev -w @unispace/web",
    "build": "npm run build -w @unispace/shared && npm run build -w @unispace/server && npm run build -w @unispace/web",
    "start": "npm run start -w @unispace/server",
    "typecheck": "npm run typecheck -w @unispace/shared && npm run typecheck -w @unispace/server && npm run typecheck -w @unispace/web",
    "lint": "npm run typecheck",
    "test": "npm run test -w @unispace/server",
    "test:smoke": "npm run test:smoke -w @unispace/server",
    "test:security": "npm run test:security -w @unispace/server",
    "test:ui": "node scripts/ui-e2e.mjs",
    "db:migrate": "npm run db:migrate -w @unispace/server",
    "db:generate": "npm run db:generate -w @unispace/server",
    "db:seed": "npm run db:seed -w @unispace/server",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
